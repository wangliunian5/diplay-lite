<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 无线链路所需（4.1 均为安装即授予的普通权限，无运行时权限） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- mDNS 组播存活的关键（难点 B1） -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- B3 信道读取：4.1 的 WifiManager.getScanResults 需要定位权限 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 麦克风上行（CarPlay 语音）；targetSdk 19 下安装即授予 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 无 adb 实测：文件日志写 /sdcard/DiPlayLite（普通权限，4.1 安装即授予） -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:name=".LiteApp"
        android:label="DiPlay Lite"
        android:allowBackup="false"
        android:hardwareAccelerated="true">

        <!-- M4k：车机场景默认横屏（/info 的车机屏尺寸、视频编码尺寸、触摸坐标都随之变成 960x540 这种横向值）。
             M4l：configChanges 补齐所有可能触发重建的配置项——本工程零 XML 资源（无布局/无字符串），
             重建什么都不会变好，只会白销毁一次 SurfaceView 的 Surface（解码器要重配+等关键帧，画面冻 1~5s）。
             实测 M4k 一次会话里 Activity 被重建 3 次（`M0 骨架就绪` 4 条），每次都对应一段 shown 掉到 2.8fps 的卡顿。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|fontScale|density|layoutDirection|locale"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".LiteSessionService"
            android:exported="false" />
    </application>
</manifest>
