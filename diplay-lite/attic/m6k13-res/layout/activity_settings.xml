<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页（竖屏）：单列卡片，行式布局 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical"
    android:padding="@dimen/page_padding">

    <!-- 标题行：返回 + 设置 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_h"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/title_settings"
            android:scaleType="centerInside" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="@string/title_settings"
            android:textColor="@color/text_dark"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <!-- 分辨率自定义 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/resolution_custom"
                android:textColor="@color/text_dark"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/input_scale"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_line"
                    android:hint="@string/scale_hint"
                    android:inputType="number"
                    android:paddingBottom="8dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="8dp"
                    android:singleLine="true"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_hint"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_apply_scale"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/btn_h_small"
                    android:layout_marginLeft="10dp"
                    android:minWidth="64dp"
                    android:background="@drawable/btn_small_primary"
                    android:text="@string/apply"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 导航音频触发音量降低 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/duck_label"
                android:textColor="@color/text_dark"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/input_duck"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_line"
                    android:hint="@string/duck_hint"
                    android:inputType="number"
                    android:paddingBottom="8dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="8dp"
                    android:singleLine="true"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_hint"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_apply_duck"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/btn_h_small"
                    android:layout_marginLeft="10dp"
                    android:minWidth="64dp"
                    android:background="@drawable/btn_small_primary"
                    android:text="@string/apply"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 横竖屏切换 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/orientation_label"
                android:textColor="@color/text_dark"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/rg_orientation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_orient_land"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/orient_land"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rb_orient_portrait"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/orient_portrait"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rb_orient_auto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/orient_auto"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp" />
            </RadioGroup>

            <!-- 音视频路径选择 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/avpath_label"
                android:textColor="@color/text_dark"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/rg_avpath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_av_full"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/avpath_full"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rb_av_bt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/avpath_bt"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp" />
            </RadioGroup>

            <!-- 车机音频通道选择 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/audio_channel_label"
                android:textColor="@color/text_dark"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/rg_audio_channel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_ch_media"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ch_media"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rb_ch_nav"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ch_nav"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp" />
            </RadioGroup>

            <!-- 体验优化 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/optimize_label"
                android:textColor="@color/text_dark"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/cb_boot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/cb_boot"
                android:textColor="@color/text_dark"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cb_autoconnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cb_autoconnect"
                android:textColor="@color/text_dark"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cb_softdecode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cb_softdecode"
                android:textColor="@color/text_dark"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cb_fps30"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cb_fps30"
                android:textColor="@color/text_dark"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cb_speaker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cb_speaker"
                android:textColor="@color/text_dark"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_divider" />

            <!-- 高级参数：信道 / 加密（连接链路真实需要的存量字段） -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/advanced_toggle"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/channel_label"
                android:textColor="@color/text_gray"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/input_channel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_line"
                android:hint="@string/channel_hint"
                android:inputType="number"
                android:paddingBottom="8dp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="8dp"
                android:singleLine="true"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/security_label"
                android:textColor="@color/text_gray"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/spn_security"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_divider" />

            <!-- 自定义返回图标 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/return_icon"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_return_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/btn_h_small"
                    android:minWidth="72dp"
                    android:background="@drawable/btn_small_outline"
                    android:text="@string/enter"
                    android:textColor="@color/primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 方向盘按键学习 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/wheel_learning"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_wheel"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/btn_h_small"
                    android:minWidth="72dp"
                    android:background="@drawable/btn_small_outline"
                    android:text="@string/enter"
                    android:textColor="@color/primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_divider" />

            <!-- 关于：显示真实 versionName（M15 纪律，不写死） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/about"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_gray"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
