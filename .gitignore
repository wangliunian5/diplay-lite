# Android Studio and local IDE state
.idea/
*.iml
.vscode/

# Gradle and local tooling
.gradle/
.kotlin/
build/
local.properties
# Machine/JDK-specific Gradle settings (e.g. sandbox org.gradle.java.home path)
gradle.properties

# Native build output
.cxx/
.externalNativeBuild/
captures/

# Local agent working notes
/agent_docs/

# OS files
.DS_Store
Thumbs.db
*.log
/.idea

# JVM crash/heap dumps (local build evidence, never commit)
*.hprof

# Local beta credentials and release signing (never commit)
.private/
*.jks
*.keystore
release-signing.properties

# Never commit credential containers or installable distribution artifacts.
# 注：*.pk8 / *.p7b 已放开以在仓库留存 CarPlay 认证（user 要求）
*.p12
*.pfx
*.pem
*.key
*.apk
*.aab

# Allow archived release APKs (keep only the last 3)
!apks/*.apk

# 车主隐私与取证产物、反编译工作区、外部引用仓（仅本地留存，永不入仓）
logs/
tmp-analysis/
legacy-ref/
log-repo/
log-collection/
log-collection-tmp/
gitee-logs/
gitee-logs-已排查-20261007/
t3-root-debug/
backup/
hardware-stage/
*.pcap
